# Copie este arquivo para .env.local.
# NUNCA commitar .env.local (já está no .gitignore).

# Depois de conectar o addon "Postgres" (Neon) ao projeto (dashboard Vercel >
# Storage > Connect Database), rode `vercel env pull .env.local` pra puxar
# DATABASE_URL automaticamente. Não precisa preencher manualmente.
DATABASE_URL=

# URL de implantação do Google Apps Script (Web App) — ver apps-script/Code.gs.
GOOGLE_SHEETS_WEBHOOK_URL=
